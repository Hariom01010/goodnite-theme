{
    "key": "group_goodnite_technology_section",
    "title": "Homepage - Technology Section",
    "fields": [
        {
            "key": "field_tech_title",
            "label": "Section Heading",
            "name": "tech_title",
            "type": "text",
            "default_value": "Inside Goodnite Technology."
        },
        {
            "key": "field_tech_cta_label",
            "label": "CTA Button Label",
            "name": "tech_cta_label",
            "type": "text",
            "default_value": "Explore Technologies"
        },
        {
            "key": "field_tech_cta_url",
            "label": "CTA Button URL",
            "name": "tech_cta_url",
            "type": "text",
            "default_value": "/sleep-technology"
        },
        {
            "key": "field_tech_cards",
            "label": "Technology Cards (3 Cards)",
            "name": "tech_cards",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add Technology Card",
            "instructions": "Configure the 3 technology pillar cards: Image, Title, Subtitle, and Description.",
            "sub_fields": [
                {
                    "key": "field_card_image",
                    "label": "Card Image",
                    "name": "image",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium",
                    "library": "all"
                },
                {
                    "key": "field_card_title",
                    "label": "Card Title",
                    "name": "title",
                    "type": "text",
                    "placeholder": "Our Fabric",
                    "default_value": "Our Fabric"
                },
                {
                    "key": "field_card_subtitle",
                    "label": "Card Subtitle / Microcopy",
                    "name": "subtitle",
                    "type": "text",
                    "placeholder": "Includes anti-static, cooling, protective and comfort-focused fabric technologies.",
                    "default_value": "Includes anti-static, cooling, protective and comfort-focused fabric technologies."
                },
                {
                    "key": "field_card_description",
                    "label": "Card Description",
                    "name": "description",
                    "type": "textarea",
                    "rows": 3,
                    "default_value": "The sleep surface is where comfort begins. Goodnite’s fabric technologies are designed around cooling, softness, protection and everyday sleep comfort."
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ],
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-templates/front-page.php"
            }
        ]
    ],
    "menu_order": 5,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
