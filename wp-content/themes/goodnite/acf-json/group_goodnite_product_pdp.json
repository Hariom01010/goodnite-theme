{
    "key": "group_goodnite_product_pdp",
    "title": "Goodnite Mattress PDP Configuration",
    "fields": [
        {
            "key": "field_pdp_tab_overview",
            "label": "Overview",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_pdp_tagline",
            "label": "Product Tagline",
            "name": "product_tagline",
            "type": "text",
            "instructions": "Short descriptor below product name",
            "default_value": "Everyday comfort, thoughtfully engineered."
        },
        {
            "key": "field_pdp_comfort_pos",
            "label": "Comfort Feel Position",
            "name": "comfort_feel_position",
            "type": "select",
            "instructions": "Active index on the 5-point comfort scale (0 to 4)",
            "choices": {
                "0": "Extra Firm",
                "1": "Firm",
                "2": "Medium",
                "3": "Plush",
                "4": "Extra Plush"
            },
            "default_value": "3",
            "allow_null": 0,
            "multiple": 0,
            "ui": 1,
            "return_format": "value"
        },
        {
            "key": "field_pdp_comfort_notes",
            "label": "Comfort Feel Notes",
            "name": "comfort_feel_notes",
            "type": "text",
            "instructions": "Optional custom notes about comfort feel"
        },
        {
            "key": "field_pdp_tab_features",
            "label": "Feature Pills",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_pdp_feature_pills",
            "label": "Feature Pills",
            "name": "pdp_feature_pills",
            "type": "repeater",
            "instructions": "Key feature pills displayed in header with 24x24 icons",
            "layout": "table",
            "button_label": "Add Feature Pill",
            "sub_fields": [
                {
                    "key": "field_pdp_pill_preset",
                    "label": "Preset Icon",
                    "name": "pill_preset",
                    "type": "select",
                    "instructions": "Select a built-in icon preset or choose Custom",
                    "choices": {
                        "core-support": "Core Support",
                        "natural-freshness": "Natural Freshness",
                        "quilted-finish": "Quilted Finish",
                        "responsive-comfort": "Responsive Comfort",
                        "custom": "Custom Icon"
                    },
                    "default_value": "core-support"
                },
                {
                    "key": "field_pdp_pill_icon",
                    "label": "Custom Icon",
                    "name": "pill_icon",
                    "type": "image",
                    "instructions": "24x24 icon image (used when Preset Icon is Custom)",
                    "return_format": "array",
                    "preview_size": "thumbnail",
                    "library": "all"
                },
                {
                    "key": "field_pdp_pill_label",
                    "label": "Feature Label",
                    "name": "pill_label",
                    "type": "text",
                    "instructions": "Label displayed next to the icon",
                    "default_value": "Core Support"
                }
            ]
        },
        {
            "key": "field_pdp_tab_const",
            "label": "Construction",
            "name": "",
            "type": "tab",
