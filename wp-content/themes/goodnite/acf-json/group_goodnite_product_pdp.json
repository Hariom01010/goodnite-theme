                {
                    "key": "field_pdp_tech_video",
                    "label": "Video Asset (MP4)",
                    "name": "tech_video",
                    "type": "file",
                    "return_format": "array",
                    "mime_types": "mp4",
                    "library": "all"
                },
                {
                    "key": "field_pdp_tech_poster",
                    "label": "Poster Image",
                    "name": "tech_poster",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium",
                    "library": "all"
                }
            ]
