{
    "key": "group_goodnite_products_section",
    "title": "Homepage - Products Section",
    "fields": [
        {
            "key": "field_products_title",
            "label": "Section Title",
            "name": "products_title",
            "type": "text",
            "default_value": "Comfort Worth Discovering."
        },
        {
            "key": "field_products_cta_label",
            "label": "CTA Text",
            "name": "products_cta_label",
            "type": "text",
            "default_value": "Shop All Mattresses"
        },
        {
            "key": "field_products_cta_url",
            "label": "CTA Link URL",
            "name": "products_cta_url",
            "type": "text",
            "default_value": "/mattresses"
        },
        {
            "key": "field_products_repeater",
            "label": "Featured WooCommerce Products",
            "name": "products_repeater",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add WooCommerce Product",
            "instructions": "Select which WooCommerce products appear in the carousel. The cards will display the selected products in this exact order.",
            "sub_fields": [
                {
                    "key": "field_prod_item",
                    "label": "Select Product",
                    "name": "product",
                    "type": "post_object",
                    "post_type": ["product"],
                    "allow_null": 0,
                    "multiple": 0,
                    "return_format": "id"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ],
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-templates/front-page.php"
            }
        ]
    ],
    "menu_order": 3,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
