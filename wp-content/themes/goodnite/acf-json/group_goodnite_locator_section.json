{
    "key": "group_goodnite_locator_section",
    "title": "Homepage - Store Locator Section",
    "fields": [
        {
            "key": "field_store_image",
            "label": "Showroom Image",
            "name": "store_image",
            "type": "image",
            "instructions": "Showroom photograph (Recommended 4:3 aspect ratio, e.g. 1600x1200)",
            "return_format": "array",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_store_title",
            "label": "Section Title",
            "name": "store_title",
            "type": "text",
            "default_value": "Feel the Difference."
        },
        {
            "key": "field_store_body",
            "label": "Description",
            "name": "store_body",
            "type": "textarea",
            "rows": 3,
            "default_value": "Find a Goodnite showroom or authorized retail partner near you."
        },
        {
            "key": "field_store_button",
            "label": "Search Button Text",
            "name": "store_button",
            "type": "text",
            "default_value": "Find Dealers"
        },
        {
            "key": "field_store_url",
            "label": "Form Action URL",
            "name": "store_url",
            "type": "text",
            "default_value": "/stores"
        }
    ],
    "location": [
        [
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ],
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-templates/template-home.php"
            }
        ],
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "front-page.php"
            }
        ]
    ],
    "menu_order": 8,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
